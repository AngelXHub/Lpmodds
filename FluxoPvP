local function HasLOS(part)
    if not part then return false end
    local char = LocalPlayer.Character
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, part.Parent }
    local r = workspace:Raycast(origin, part.Position - origin, params)
    return r == nil
end

local function GetSilentTarget()
    local closest, shortest = nil, Settings.SilentRange
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.SilentTeamCheck and IsAlly(p) then continue end

            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = char:FindFirstChild(Settings.SilentHitPart)
                if part then
                    if Settings.SilentWallCheck and not HasLOS(part) then continue end
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortest then
                            shortest = d
                            closest = p
                        end
                    end
                end
            end
        end
    end
    return closest
end

