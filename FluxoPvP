local function enableThirdPerson()
    if ThirdPersonConnection then ThirdPersonConnection:Disconnect() end
    ThirdPersonConnection = Services.RunService.RenderStepped:Connect(function()
        if not Settings.ThirdPerson then return end
        if not LocalPlayer.Character then return end
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local direction = (Camera.CFrame.Position - hrp.Position).Unit
        local newCameraPos = hrp.Position + direction * 12 + Vector3.new(0, 2, 0)
        Camera.CFrame = CFrame.lookAt(newCameraPos, hrp.Position + Vector3.new(0, 1.5, 0))
    end)
end

local function disableThirdPerson()
    if ThirdPersonConnection then
        ThirdPersonConnection:Disconnect()
        ThirdPersonConnection = nil
    end
end

