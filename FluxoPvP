local function applyHSProxy(mode)
    for head, size in pairs(HitboxAltaOriginalSizes) do
        if head and head.Parent then head.Size = size end
    end
    HitboxAltaOriginalSizes = {}
    Settings.HitboxAltaEnabled = false
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in pairs(player.Character:GetChildren()) do
                if part:IsA("BasePart") then
                    local origName = HSOriginalNames[part]
                    if origName then part.Name = origName; HSOriginalNames[part] = nil end
                    local origName2 = OnlyHSOriginalNames[part]
                    if origName2 then part.Name = origName2; OnlyHSOriginalNames[part] = nil end
                    local origSize = HSPescocoOriginalSizes[part]
                    if origSize then part.Size = origSize; HSPescocoOriginalSizes[part] = nil end
                end
            end
        end
    end
    if mode == "HS Alto" then
        Settings.HitboxAltaEnabled = true
    elseif mode == "HS Pescoço" then
        for _, player in pairs(Services.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and IsEnemy(player) then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    if not HSPescocoOriginalSizes[head] then HSPescocoOriginalSizes[head] = head.Size end
                    head.Size = Vector3.new(
                        HSPescocoOriginalSizes[head].X * Settings.HSPescocoSize,
                        HSPescocoOriginalSizes[head].Y * Settings.HSPescocoSize,
                        HSPescocoOriginalSizes[head].Z * Settings.HSPescocoSize
                    )
                    head.Massless = true
                    head.Transparency = 0.7
                end
            end
        end
    elseif mode == "Only HS" then
        for _, player in pairs(Services.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and IsEnemy(player) then
                for _, part in pairs(player.Character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "Head" and part.Name ~= "HumanoidRootPart" then
                        if not OnlyHSOriginalNames[part] then OnlyHSOriginalNames[part] = part.Name end
                        part.Name = "Head"
                    end
                end
            end
        end
    end
end

