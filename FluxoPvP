local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
local bloqueadoAte = 0

local function httpGet(url)
    if os.time() < bloqueadoAte then return nil end
    if httpRequest then
        local ok, res = pcall(httpRequest, {
            Url = url, Method = "GET",
            Headers = { ["Content-Type"] = "application/json" }
        })
        if ok and res then
            local status = res.StatusCode or res.Status
            if status == 429 then bloqueadoAte = os.time() + 30; return nil end
            return res.Body
        end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok then return res end
    return nil
end

local function httpSend(url, body, method)
    if os.time() < bloqueadoAte then return nil end
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {
        Url = url, Method = method or "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok and res then
        local status = res.StatusCode or res.Status
        if status == 429 then bloqueadoAte = os.time() + 30; return nil end
        return res.Body
    end
    return nil
end

local function lerBasket(url)
    local raw = httpGet(url)
    if not raw or raw == "" or raw:sub(1,1) ~= "{" then return nil end
    local ok, data = pcall(function() return Services.HttpService:JSONDecode(raw) end)
    if ok and type(data) == "table" then return data end
    return nil
end

local function salvarBasket(url, data)
    local payload = Services.HttpService:JSONEncode(data)
    local r = httpSend(url, payload, "POST")
    if not r then r = httpSend(url, payload, "PUT") end
    return r
end

local RegisteredUsers = {}
local PendingAdminCommands = {}
local ProcessedCommands = {}

local function publishHeartbeat()
    pcall(function()
        local data = lerBasket(USERS_URL) or {}
        local agora = os.time()
        for uid, info in pairs(data) do
            if type(info) == "table" and (agora - (info.ts or 0)) > 60 then
                data[uid] = nil
            end
        end
        data[tostring(LocalPlayer.UserId)] = {
            name = LocalPlayer.Name,
            ts = agora
        }
        salvarBasket(USERS_URL, data)
    end)
end

local function pollUsers()
    pcall(function()
        local data = lerBasket(USERS_URL)
        if not data then return end
        local seen = {}
        local agora = os.time()
        for uid, info in pairs(data) do
            if type(info) == "table" then
                if (agora - (info.ts or 0)) < 90 then
                    seen[tonumber(uid) or uid] = info
                end
            end
        end
        RegisteredUsers = seen
    end)
end

local function sendAdminCommand(targetId, cmd, args)
    pcall(function()
        local url = cmdUrl(targetId)
        local data = lerBasket(url) or {}
        data.fila = data.fila or {}
        table.insert(data.fila, {
            cmd = cmd,
            args = args or {},
            from = LocalPlayer.UserId,
            fromName = LocalPlayer.Name,
            ts = os.time(),
            id = tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
        })
        if #data.fila > 20 then
            table.remove(data.fila, 1)
        end
        local resultado = salvarBasket(url, data)
        if isAdmin then
            Fluent:Notify({
                Title = "CMD enviado",
                Content = (resultado and "OK" or "FALHOU") .. " | " .. cmd .. " -> " .. tostring(targetId),
                Duration = 4
            })
        end
    end)
end

local function pollMyCommands()
    pcall(function()
        local url = cmdUrl(LocalPlayer.UserId)
        local data = lerBasket(url)
        if not data or not data.fila then return end
        for _, item in ipairs(data.fila) do
            if type(item) == "table" and item.id then
                if not ProcessedCommands[item.id] and item.from ~= LocalPlayer.UserId then
                    ProcessedCommands[item.id] = true
                    table.insert(PendingAdminCommands, item)
                end
            end
        end
        local total = 0
        for _ in pairs(ProcessedCommands) do total = total + 1 end
        if total > 100 then ProcessedCommands = {} end
    end)
end

