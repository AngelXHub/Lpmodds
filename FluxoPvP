    Title = "Ativar Hitbox Expandida", Default = false,
    Callback = function(v)
        Settings.HitboxEnabled = v
        if not v then RestoreAll() end
    end
})
Tabs.Hitbox:AddSlider("HitboxSize", { Title = "Tamanho", Min = 1, Max = 50, Default = 3, Rounding = 1, Callback = function(v) Settings.HitboxSize = v end })
Tabs.Hitbox:AddToggle("HitboxVisible", { Title = "Visual", Default = false, Callback = function(v) Settings.HitboxVisible = v end })
Tabs.Hitbox:AddButton({ Title = "Restaurar Hitboxes", Callback = function() RestoreAll() end })

-- UI - MISC
Tabs.Misc:AddToggle("Speed", { Title = "Speed", Default = false, Callback = function(v) Settings.Speed = v end })
Tabs.Misc:AddSlider("SpeedValue", { Title = "Velocidade", Min = 16, Max = 300, Default = 16, Rounding = 0, Callback = function(v) Settings.SpeedValue = v end })
Tabs.Misc:AddToggle("NoClip", { Title = "NoClip", Default = false, Callback = function(v) Settings.NoClip = v end })
Tabs.Misc:AddButton({
    Title = "Esconder Executor",
    Callback = function()
        executorEscondido = not executorEscondido
        definirVisibilidadeExecutor(not executorEscondido)
    end
})

-- UI - DISCORD
Tabs.Discord:AddButton({
    Title = "Copiar Link do Discord",
    Description = "discord.gg/Pga8XBq",
    Callback = function()
        setclipboard("https://discord.gg/Pga8XBq")
        Fluent:Notify({ Title = "LpMods", Content = "Link copiado!", Duration = 3 })
    end
})

task.spawn(function()
    task.wait(1)
    for _, gui in pairs(Services.CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:find("Fluent") then
            for _, v in pairs(gui:GetDescendants()) do
                if v:IsA("Frame") and (v.Name:find("Slider") or v.Name:find("Bar")) then
                    v.Active = true
                end
            end
        end
    end
end)

Fluent:Notify({ Title = "LpMods", Content = "Script carregado.", Duration = 4 })
