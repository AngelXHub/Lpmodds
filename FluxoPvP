local function GetClosestPlayer()
    local target = nil
    local maxDist = Settings.FOVSize
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.TeamCheck and not IsEnemy(p) then continue end
            local char = p.Character
            local aimPart = char:FindFirstChild(Settings.AimPart)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if aimPart and hum then
                if Settings.IgnoreDead then
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead or not char:IsDescendantOf(workspace) then continue end
                else
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then continue end
                end
                if Settings.WallCheck and not HasLOS(aimPart) then continue end
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                if onScreen then
                    local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if d <= maxDist then maxDist = d; target = p end
                end
            end
        end
    end
    return target
end

local function GetSilentTarget()
    local closest, shortest = nil, Settings.SilentRange
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.SilentTeamCheck and not IsEnemy(p) then continue end
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = char:FindFirstChild(Settings.SilentHitPart)
                if part then
                    if Settings.SilentWallCheck and not HasLOS(part) then continue end
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortest then shortest = d; closest = p end
                    end
                end
            end
        end
    end
    return closest
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if isPremium and Settings.Silent and method == "FireServer" and self:IsA("RemoteEvent") then
        local target = GetSilentTarget()
        if target and target.Character then
            local part = target.Character:FindFirstChild(Settings.SilentHitPart)
            if part then
                if math.random(1, 100) > Settings.SilentChance then return oldNamecall(self, ...) end
                local aimPos = part.Position
                local args = {...}
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then args[i] = aimPos; changed = true
                    elseif typeof(v) == "CFrame" then args[i] = CFrame.lookAt(v.Position, aimPos); changed = true end
                end
                if changed then return oldNamecall(self, table.unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

