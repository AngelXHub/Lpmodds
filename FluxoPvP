    local contador = 0
    while task.wait(6) do
        if os.time() < bloqueadoAte then continue end
        contador = contador + 1

        task.spawn(pollMyCommands)
        if #PendingAdminCommands > 0 then
            for _, cmd in ipairs(PendingAdminCommands) do
                pcall(function() handleIncomingCommand(cmd) end)
            end
            PendingAdminCommands = {}
        end

        if contador % 3 == 0 then
            task.spawn(publishHeartbeat)
            task.spawn(pollUsers)
        end
    end
end)

