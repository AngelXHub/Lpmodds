local function GetClosestPlayer()
    local Target = nil
    local MaxDistance = Settings.FOVSize
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")

            if head and humanoid and rootPart then
                if Settings.TeamCheck and IsAlly(player) then continue end
                if Settings.IgnoreDead then
                    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead or not char:IsDescendantOf(workspace) then continue end
                else
                    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then continue end
                end
                if Settings.WallCheck and not HasLineOfSight(head) then continue end

                local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(headPos.X, headPos.Y) - CenterScreen).Magnitude
                    if distance <= MaxDistance then
                        MaxDistance = distance
                        Target = player
                    end
                end
            end
        end
    end
    return Target
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Settings.Silent and Settings.Aimbot and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast") then
        local args = {...}
        local ray = args[1]
        local comprimento = 0
        if typeof(ray) == "Ray" then comprimento = ray.Direction.Magnitude
        elseif typeof(ray) == "Vector3" then comprimento = ray.Magnitude end
        if comprimento > 0 and comprimento < 30 then return oldNamecall(self, ...) end

        local myChar = LocalPlayer.Character
        if myChar and typeof(ray) == "Ray" then
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if myHRP and (ray.Origin - myHRP.Position).Magnitude < 3 then
                return oldNamecall(self, ...)
            end
        end

        if typeof(ray) == "Ray" and ray.Direction.Unit.Y < -0.7 then
            return oldNamecall(self, ...)
        end

        local target = GetClosestPlayer()
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                if method == "Raycast" then
                    args[2] = head.Position
                else
                    if typeof(ray) == "Ray" then
                        local dir = (head.Position - ray.Origin).Unit * (ray.Direction.Magnitude > 0 and ray.Direction.Magnitude or 1000)
                        args[1] = Ray.new(ray.Origin, dir)
                    end
                end
                return oldNamecall(self, table.unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

