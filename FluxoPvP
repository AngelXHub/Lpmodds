local OriginalHitbox = {}

local function IsAlly(player)
    if not player or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function HasLineOfSight(targetPart)
    if not targetPart then return false end
    local myChar = LocalPlayer.Character
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, targetPart.Parent }
    local result = workspace:Raycast(origin, targetPart.Position - origin, params)
    return result == nil
end

local function ApplyHitbox(player)
    local char = player.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp then return end

    if not OriginalHitbox[player] then
        OriginalHitbox[player] = {
            hrpSize = hrp.Size,
            hrpTransparency = hrp.Transparency,
            hrpCanCollide = hrp.CanCollide,
            headSize = head and head.Size or nil,
            headTransparency = head and head.Transparency or nil,
        }
    end

    local orig = OriginalHitbox[player]
    local mult = Settings.HitboxSize

    hrp.Size = Vector3.new(
        orig.hrpSize.X * mult,
        orig.hrpSize.Y * mult,
        orig.hrpSize.Z * mult
    )
    hrp.Transparency = Settings.HitboxVisible and 0.5 or 1
    hrp.CanCollide = false

    if head and orig.headSize then
        head.Size = Vector3.new(
            orig.headSize.X * mult,
            orig.headSize.Y * mult,
            orig.headSize.Z * mult
        )
        head.Transparency = Settings.HitboxVisible and 0.5 or 1
        head.CanCollide = false
    end
end

local function RestoreHitbox(player)
    local char = player.Character
    local orig = OriginalHitbox[player]
    if not char or not orig then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")

    if hrp then
        hrp.Size = orig.hrpSize
        hrp.Transparency = orig.hrpTransparency
        hrp.CanCollide = orig.hrpCanCollide
    end
    if head and orig.headSize then
        head.Size = orig.headSize
        head.Transparency = orig.headTransparency
    end

    OriginalHitbox[player] = nil
end

local function RestoreAllHitboxes()
    for player, _ in pairs(OriginalHitbox) do
        RestoreHitbox(player)
    end
    OriginalHitbox = {}
end

Services.RunService.Heartbeat:Connect(function()
