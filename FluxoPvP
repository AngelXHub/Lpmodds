local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function httpGet(url)
    if httpRequest then
        local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.Body end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok then return res end
    return nil
end

local function httpPost(url, body)
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {
        Url = url,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok then return res end
    return nil
end

local RegisteredUsers = {}
local LastCommandTs = os.time() - 5
local PendingAdminCommands = {}

local function publishHeartbeat()
    pcall(function()
        httpPost(NTFY .. TOPIC_USERS, Services.HttpService:JSONEncode({
            uid = LocalPlayer.UserId,
            name = LocalPlayer.Name,
            ts = os.time()
        }))
    end)
end

local function pollUsers()
    local raw = httpGet(NTFY .. TOPIC_USERS .. "/json?poll=1&since=45s")
    if not raw then return end
    local seen = {}
    for line in raw:gmatch("[^\n]+") do
        local ok, msg = pcall(function() return Services.HttpService:JSONDecode(line) end)
        if ok and msg and msg.message then
            local ok2, data = pcall(function() return Services.HttpService:JSONDecode(msg.message) end)
            if ok2 and data and data.uid then
                local age = os.time() - (data.ts or 0)
                if age < 45 then seen[data.uid] = data end
            end
        end
    end
    RegisteredUsers = seen
end

local function pollMyCommands()
    local raw = httpGet(NTFY .. topicCmd(LocalPlayer.UserId) .. "/json?poll=1&since=15s")
    if not raw then return end
    for line in raw:gmatch("[^\n]+") do
        local ok, msg = pcall(function() return Services.HttpService:JSONDecode(line) end)
        if ok and msg and msg.message then
            local ok2, data = pcall(function() return Services.HttpService:JSONDecode(msg.message) end)
            if ok2 and data and data.cmd and (data.ts or 0) > LastCommandTs then
                LastCommandTs = data.ts or os.time()
                if data.from ~= LocalPlayer.UserId then
                    table.insert(PendingAdminCommands, data)
                end
            end
        end
    end
end

