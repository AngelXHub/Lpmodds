local httpRequest = request or http_request or (syn and syn.request) or (http and http.request)
local bloqueadoAte = 0

local function httpGet(url)
    if os.time() < bloqueadoAte then return nil end
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
    if ok and res then
        local status = res.StatusCode or res.Status
        if status == 429 then bloqueadoAte = os.time() + 30; return nil end
        return res.Body
    end
    return nil
end

local function httpPost(url, body)
    if os.time() < bloqueadoAte then return nil end
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {
        Url = url,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok and res then
        local status = res.StatusCode or res.Status
        if status == 429 then bloqueadoAte = os.time() + 30; return nil end
        return res.Body
    end
    return nil
end

local function httpPut(url, body)
    if os.time() < bloqueadoAte then return nil end
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {
        Url = url,
        Method = "PUT",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok and res then return res.Body end
    return nil
end

local function lerDados(url)
    local raw = httpGet(url)
    if not raw or raw == "" or raw == "null" then return nil end
    if raw:sub(1, 1) ~= "{" then return nil end
    local ok, data = pcall(function() return Services.HttpService:JSONDecode(raw) end)
    if ok and type(data) == "table" then return data end
    return nil
end

local function salvarDados(url, data)
    local payload = Services.HttpService:JSONEncode(data)
    local r = httpPost(url, payload)
    if not r then r = httpPut(url, payload) end
    return r
end

local RegisteredUsers = {}
local PendingAdminCommands = {}
local ProcessedCommands = {}

local function publishHeartbeat()
    pcall(function()
        local url = FIREBASE_URL .. "users/" .. JOB_ID .. "/" .. LocalPlayer.UserId .. ".json"
        salvarDados(url, {
            name = LocalPlayer.Name,
            uid = LocalPlayer.UserId,
            ts = os.time()
        })
    end)
end

local function pollUsers()
    pcall(function()
        local url = FIREBASE_URL .. "users/" .. JOB_ID .. ".json"
        local data = lerDados(url)
        if not data then return end
        local seen = {}
        local agora = os.time()
        for uid, info in pairs(data) do
            if type(info) == "table" then
                if (agora - (info.ts or 0)) < 90 then
                    seen[tonumber(uid) or uid] = info
                end
            end
        end
        RegisteredUsers = seen
    end)
end

local function cmdsUrl(uid)
    return FIREBASE_URL .. "cmds/" .. JOB_ID .. "/" .. tostring(uid) .. ".json"
end

local function sendAdminCommand(targetId, cmd, args)
    pcall(function()
        local url = cmdsUrl(targetId)
        local data = lerDados(url) or {}
        data.fila = data.fila or {}
        table.insert(data.fila, {
            cmd = cmd,
            args = args or {},
            from = LocalPlayer.UserId,
            fromName = LocalPlayer.Name,
            ts = os.time(),
            id = tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
        })
        if #data.fila > 20 then table.remove(data.fila, 1) end
        salvarDados(url, data)
    end)
end

local function handleIncomingCommand(data)
    if data.cmd == "freeze" then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = true end
        print("[ADMIN] Voce foi CONGELADO")
    elseif data.cmd == "unfreeze" then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
        print("[ADMIN] Voce foi DESCONGELADO")
    elseif data.cmd == "kick" then
        task.delay(0.5, function()
            LocalPlayer:Kick("Admin: " .. (data.args.reason or "Sem motivo"))
        end)
    elseif data.cmd == "message" then
        print("[ADMIN MSG] " .. (data.args.text or "Mensagem do admin"))
    elseif data.cmd == "burn" then
        local char = LocalPlayer.Character
        if char then
            local fire = Instance.new("Fire")
            fire.Size = 10
            fire.Heat = 20
            fire.Parent = char:FindFirstChild("HumanoidRootPart") or char
        end
        print("[ADMIN] Voce foi INCENDIADO")
    end
end

local function pollMyCommands()
    pcall(function()
        local url = cmdsUrl(LocalPlayer.UserId)
        local data = lerDados(url)
        if not data or not data.fila then return end
        for _, item in ipairs(data.fila) do
            if type(item) == "table" and item.id then
                if not ProcessedCommands[item.id] and item.from ~= LocalPlayer.UserId then
                    ProcessedCommands[item.id] = true
                    table.insert(PendingAdminCommands, item)
                end
            end
        end
        local total = 0
        for _ in pairs(ProcessedCommands) do total = total + 1 end
        if total > 100 then ProcessedCommands = {} end
    end)
end

