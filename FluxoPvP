    end)
end

local function AddSlider(parent, name, min, max, default, suffix, callback)
    local item = Instance.new("Frame"); item.Size = UDim2.new(1, -6, 0, 62); item.BackgroundColor3 = C.CARD; item.BorderSizePixel = 0; item.Parent = parent
    local IC = Instance.new("UICorner"); IC.CornerRadius = UDim.new(0, 6); IC.Parent = item
    local IS = Instance.new("UIStroke"); IS.Color = C.BORDER; IS.Thickness = 1; IS.Parent = item
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, -80, 0, 16); lbl.Position = UDim2.fromOffset(14, 8); lbl.BackgroundTransparency = 1; lbl.Text = name; lbl.TextColor3 = C.TEXT; lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = item
    local val = Instance.new("TextLabel"); val.Size = UDim2.fromOffset(58, 22); val.Position = UDim2.new(1, -72, 0, 6); val.BackgroundColor3 = C.INPUT; val.BorderSizePixel = 0; val.Text = tostring(default) .. (suffix or ""); val.TextColor3 = C.ACCENT; val.Font = Enum.Font.GothamBold; val.TextSize = 10; val.Parent = item
    local VC = Instance.new("UICorner"); VC.CornerRadius = UDim.new(0, 4); VC.Parent = val
    local bar = Instance.new("Frame"); bar.Size = UDim2.new(1, -28, 0, 6); bar.Position = UDim2.fromOffset(14, 42); bar.BackgroundColor3 = C.INPUT; bar.BorderSizePixel = 0; bar.Parent = item
    local BRC = Instance.new("UICorner"); BRC.CornerRadius = UDim.new(1, 0); BRC.Parent = bar
    local fill = Instance.new("Frame"); local ratio = math.clamp((default - min) / (max - min), 0, 1); fill.Size = UDim2.new(ratio, 0, 1, 0); fill.BackgroundColor3 = C.ACCENT; fill.BorderSizePixel = 0; fill.Parent = bar
    local FC = Instance.new("UICorner"); FC.CornerRadius = UDim.new(1, 0); FC.Parent = fill
    local knob = Instance.new("Frame"); knob.Size = UDim2.fromOffset(14, 14); knob.Position = UDim2.new(ratio, -7, 0.5, -7); knob.BackgroundColor3 = Color3.fromRGB(240, 240, 240); knob.BorderSizePixel = 0; knob.Parent = bar
    local KNC = Instance.new("UICorner"); KNC.CornerRadius = UDim.new(1, 0); KNC.Parent = knob
    local KNS = Instance.new("UIStroke"); KNS.Color = C.ACCENT; KNS.Thickness = 2; KNS.Parent = knob
    local dragging = false
    local function update(input)
        local p = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * p; v = math.floor(v * 100) / 100
        fill.Size = UDim2.new(p, 0, 1, 0); knob.Position = UDim2.new(p, -7, 0.5, -7); val.Text = tostring(v) .. (suffix or "")
        if callback then pcall(callback, v) end
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; Services.TweenService:Create(knob, TweenInfo.new(0.15), { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(knob.Position.X.Scale, -9, 0.5, -9) }):Play(); update(i)
        end
    end)
    Services.UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end end)
    Services.UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false; Services.TweenService:Create(knob, TweenInfo.new(0.15), { Size = UDim2.fromOffset(14, 14) }):Play() end end)
end

local function AddDropdown(parent, name, options, default, callback)
    local item = Instance.new("Frame"); item.Size = UDim2.new(1, -6, 0, 46); item.BackgroundColor3 = C.CARD; item.BorderSizePixel = 0; item.Parent = parent
    local IC = Instance.new("UICorner"); IC.CornerRadius = UDim.new(0, 6); IC.Parent = item
    local IS = Instance.new("UIStroke"); IS.Color = C.BORDER; IS.Thickness = 1; IS.Parent = item
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(0.5, -14, 1, 0); lbl.Position = UDim2.fromOffset(14, 0); lbl.BackgroundTransparency = 1; lbl.Text = name; lbl.TextColor3 = C.TEXT; lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = item
    local valBox = Instance.new("Frame"); valBox.Size = UDim2.new(0.5, -18, 0, 26); valBox.Position = UDim2.new(0.5, 0, 0.5, -13); valBox.BackgroundColor3 = C.INPUT; valBox.BorderSizePixel = 0; valBox.Parent = item
    local VBC = Instance.new("UICorner"); VBC.CornerRadius = UDim.new(0, 4); VBC.Parent = valBox
    local val = Instance.new("TextLabel"); val.Size = UDim2.new(1, -22, 1, 0); val.Position = UDim2.fromOffset(8, 0); val.BackgroundTransparency = 1; val.Text = default; val.TextColor3 = C.ACCENT; val.Font = Enum.Font.GothamMedium; val.TextSize = 11; val.TextXAlignment = Enum.TextXAlignment.Left; val.Parent = valBox
    local arrow = Instance.new("TextLabel"); arrow.Size = UDim2.fromOffset(14, 14); arrow.Position = UDim2.new(1, -18, 0.5, -7); arrow.BackgroundTransparency = 1; arrow.Text = "▾"; arrow.TextColor3 = C.TEXT3; arrow.Font = Enum.Font.GothamBold; arrow.TextSize = 12; arrow.Parent = valBox
    local idx = 1; for i, o in ipairs(options) do if o == default then idx = i break end end
    local btn = Instance.new("TextButton"); btn.Size = UDim2.fromScale(1, 1); btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = item
    btn.MouseButton1Click:Connect(function()
        idx = idx + 1; if idx > #options then idx = 1 end; val.Text = options[idx]
        if callback then pcall(callback, options[idx]) end
    end)
end

