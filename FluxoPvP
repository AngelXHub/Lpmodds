    local SC = Instance.new("UICorner"); SC.CornerRadius = UDim.new(1, 0); SC.Parent = switch
    local knob = Instance.new("Frame"); knob.Size = UDim2.fromOffset(14, 14); knob.Position = default and UDim2.new(1, -17, 0.5, -7) or UDim2.fromOffset(3, 3); knob.BackgroundColor3 = Color3.fromRGB(240, 240, 240); knob.BorderSizePixel = 0; knob.Parent = switch
    local KNC = Instance.new("UICorner"); KNC.CornerRadius = UDim.new(1, 0); KNC.Parent = knob
    local state = default
    local btn = Instance.new("TextButton"); btn.Size = UDim2.fromScale(1, 1); btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = item
    btn.MouseEnter:Connect(function() Services.TweenService:Create(item, TweenInfo.new(0.15), { BackgroundColor3 = C.CARD_HOVER }):Play(); Services.TweenService:Create(IS, TweenInfo.new(0.15), { Color = C.BORDER_LIGHT }):Play() end)
    btn.MouseLeave:Connect(function() Services.TweenService:Create(item, TweenInfo.new(0.15), { BackgroundColor3 = C.CARD }):Play(); Services.TweenService:Create(IS, TweenInfo.new(0.15), { Color = C.BORDER }):Play() end)
    btn.MouseButton1Click:Connect(function()
        state = not state
        Services.TweenService:Create(switch, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { BackgroundColor3 = state and C.SWITCH_ON or C.SWITCH_OFF }):Play()
        Services.TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.fromOffset(3, 3) }):Play()
