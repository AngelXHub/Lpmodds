Services.RunService.RenderStepped:Connect(function()
    travarCamera()
    
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Settings.FOVSize
    FOVCircle.Visible = Settings.ShowFOV

    if Settings.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character then
            local part = target.Character:FindFirstChild(Settings.AimPart)
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
            end
        end
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not ESPDrawings[p] then CreateESP(p) end
            local d = ESPDrawings[p]
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local ally = IsAlly(p)
            local render = (ally and Settings.ESP_Ally) or (not ally and Settings.ESP_Master)
            
            if render and char and hum and hum.Health > 0 then
                local cf, size = char:GetBoundingBox()
                local sp, on = Camera:WorldToViewportPoint(cf.Position)
                if on then
                    local col = ally and Settings.AllyColor or CyanColor
                    local topW = cf.Position + Vector3.new(0, size.Y / 2, 0)
                    local botW = cf.Position - Vector3.new(0, size.Y / 2, 0)
                    local ts = Camera:WorldToViewportPoint(topW)
                    local bs = Camera:WorldToViewportPoint(botW)
                    local hgt = math.abs(ts.Y - bs.Y)
                    local wd = hgt / 1.6

                    if Settings.ESP_Boxes then
                        d.Box.Size = Vector2.new(wd, hgt)
                        d.Box.Position = Vector2.new(sp.X - wd / 2, ts.Y)
                        d.Box.Color = col; d.Box.Visible = true
                    else d.Box.Visible = false end

                    if Settings.ESP_Lines then
                        d.Line.From = Vector2.new(center.X, Camera.ViewportSize.Y)
                        d.Line.To = Vector2.new(sp.X, bs.Y)
                        d.Line.Color = col; d.Line.Visible = true
                    else d.Line.Visible = false end

                    if Settings.ESP_Names then
                        d.Name.Text = p.Name .. (ally and " [ALLY]" or "")
                        d.Name.Position = Vector2.new(sp.X, ts.Y - 16)
                        d.Name.Color = col; d.Name.Visible = true
                    else d.Name.Visible = false end

                    if Settings.ESP_Health then
                        d.Health.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                        d.Health.Position = Vector2.new(sp.X, bs.Y + 2)
                        d.Health.Color = Color3.fromRGB(0, 255, 0); d.Health.Visible = true
                    else d.Health.Visible = false end
                else
                    d.Box.Visible = false; d.Line.Visible = false; d.Name.Visible = false; d.Health.Visible = false
                end
            else
                d.Box.Visible = false; d.Line.Visible = false; d.Name.Visible = false; d.Health.Visible = false
            end
        end
    end
end)

Services.RunService.Heartbeat:Connect(function()
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if hrp then
                    local skip = Settings.HitboxSkipAllies and IsAlly(p)
                    if Settings.HitboxEnabled and not skip then
                        if not OriginalHitbox[p] then
                            OriginalHitbox[p] = { hrpSize = hrp.Size, hrpTrans = hrp.Transparency, hrpColl = hrp.CanCollide, headSize = head and head.Size, headTrans = head and head.Transparency }
                        end
                        local o = OriginalHitbox[p]
                        local m = Settings.HitboxSize
                        local tr = Settings.HitboxVisible and Settings.HitboxTransparency or 1
                        hrp.Size = o.hrpSize * m; hrp.Transparency = tr; hrp.CanCollide = false
                        if head and o.headSize then head.Size = o.headSize * m; head.Transparency = tr; head.CanCollide = false end
                    elseif OriginalHitbox[p] then
                        local o = OriginalHitbox[p]
                        hrp.Size = o.hrpSize; hrp.Transparency = o.hrpTrans; hrp.CanCollide = o.hrpColl
                        if head and o.headSize then head.Size = o.headSize; head.Transparency = o.headTrans end
                        OriginalHitbox[p] = nil
                    end
                end
            end
        end
    end
end)

Services.Players.PlayerRemoving:Connect(function(p) OriginalHitbox[p] = nil end)

Services.RunService.Heartbeat:Connect(function()
    if not Settings.KillAura then return end
    if tick() - lastKillAura < Settings.KillAuraDelay then return end
    lastKillAura = tick()

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local target, closest = nil, Settings.KillAuraRange
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.KillAuraTeamCheck and IsAlly(p) then continue end
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < closest then closest = d; target = p end
            end
        end
    end

    if target then
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            local oldCF = myRoot.CFrame
            pcall(function() myRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 0, 2)) end)
            task.wait(0.02)
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            pcall(function()
                if type(mouse1click) == "function" then mouse1click()
                elseif type(mouse1press) == "function" and type(mouse1release) == "function" then mouse1press(); task.wait(0.02); mouse1release() end
            end)
            task.wait(0.02)
            if myRoot and myRoot.Parent then pcall(function() myRoot.CFrame = oldCF end) end
        end
    end
end)

Services.RunService.Heartbeat:Connect(function()
    if not Settings.InfiniteAmmo then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, obj in ipairs(tool:GetDescendants()) do
                if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                    local n = obj.Name:lower()
                    if n:find("ammo") or n:find("clip") or n:find("bullet") or n:find("mag") or n:find("municao") then
                        obj.Value = Settings.InfiniteAmmoValue
                    end
                end
            end
        end
    end
end)

Services.RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if Settings.Speed and hum then hum.WalkSpeed = Settings.SpeedValue end
    if Settings.JumpPower and hum then hum.UseJumpPower = true; hum.JumpPower = Settings.JumpValue end
    if Settings.NoClip then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CanCollide = false end
        end
    end
    if Settings.Spinbot and hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(150), 0) end
    
    if Settings.Fly and hrp then
        if not FlyBV then
            FlyBV = Instance.new("BodyVelocity")
            FlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            FlyBV.Velocity = Vector3.zero
            FlyBV.Parent = hrp
        end
        local dir = Vector3.zero
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        FlyBV.Velocity = dir * Settings.FlySpeed
    elseif FlyBV then
        FlyBV:Destroy()
        FlyBV = nil
    end
end)

