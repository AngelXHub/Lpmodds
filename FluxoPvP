local function IsAlly(p)
    if not p or p == LocalPlayer then return false end
    if not LocalPlayer.Team then return false end
    if p.Team and p.Team == LocalPlayer.Team then return true end
    if p.TeamColor and LocalPlayer.TeamColor and p.TeamColor == LocalPlayer.TeamColor then return true end
    return false
end

local function HasLOS(part)
    if not part then return false end
    local char = LocalPlayer.Character
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, part.Parent }
    local r = workspace:Raycast(origin, part.Position - origin, params)
    return r == nil
end

local function travarCamera()
    local lpChar = LocalPlayer.Character
    if not lpChar then return end
    local lpHum = lpChar:FindFirstChildOfClass("Humanoid")
    if not lpHum then return end
    if Camera.CameraSubject ~= lpHum then Camera.CameraSubject = lpHum end
    if Camera.CameraType ~= Enum.CameraType.Custom then Camera.CameraType = Enum.CameraType.Custom end
end

local function GetClosestPlayer()
    local target = nil
    local maxDist = Settings.FOVSize
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.TeamCheck and IsAlly(p) then continue end
            local char = p.Character
            local part = char:FindFirstChild(Settings.AimPart)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if part and hum then
                if Settings.IgnoreDead then
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead or not char:IsDescendantOf(workspace) then continue end
                else
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then continue end
                end
                if Settings.WallCheck and not HasLOS(part) then continue end
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= maxDist then
                        maxDist = d
                        target = p
                    end
                end
            end
        end
    end
    return target
end

local function GetSilentTarget()
    local closest, shortest = nil, Settings.SilentRange
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if Settings.SilentTeamCheck and IsAlly(p) then continue end
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = char:FindFirstChild(Settings.SilentHitPart)
                if part then
                    if Settings.SilentWallCheck and not HasLOS(part) then continue end
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortest then shortest = d; closest = p end
                    end
                end
            end
        end
    end
    return closest
end

