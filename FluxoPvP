        syn.protect_gui(ScreenGui); ScreenGui.Parent = Services.CoreGui
    elseif gethui then
        ScreenGui.Parent = gethui()
    else
        ScreenGui.Parent = Services.CoreGui
    end

    local Button = Instance.new("TextButton")
    Button.Name = "FloatingButton"
    Button.Size = UDim2.fromOffset(cfg.Size, cfg.Size)
    Button.Position = cfg.Position
    Button.BackgroundColor3 = cfg.Color
    Button.BackgroundTransparency = cfg.Transparency
    Button.BorderSizePixel = 0
    Button.Active = true
    Button.Text = cfg.Text
    Button.Font = cfg.Font
    Button.TextSize = math.floor(cfg.Size * 0.36)
    Button.TextColor3 = cfg.TextColor
    Button.AutoButtonColor = false
    Button.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, math.floor(cfg.Size * 0.18))
    Corner.Parent = Button

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = cfg.StrokeColor
    Stroke.Thickness = 1.5
    Stroke.Parent = Button

    local dragging, dragStart, startPos, moved

    Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; moved = false
            dragStart = input.Position; startPos = Button.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 8 then moved = true end
            Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    Button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not moved and cfg.OnClick then pcall(cfg.OnClick) end
            dragging = false
        end
    end)

    Button.MouseEnter:Connect(function()
        Services.TweenService:Create(Button, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
        Services.TweenService:Create(Stroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(180, 190, 255) }):Play()
    end)

    Button.MouseLeave:Connect(function()
        Services.TweenService:Create(Button, TweenInfo.new(0.15), { BackgroundTransparency = cfg.Transparency }):Play()
        Services.TweenService:Create(Stroke, TweenInfo.new(0.15), { Color = cfg.StrokeColor }):Play()
    end)

    return Button
end

