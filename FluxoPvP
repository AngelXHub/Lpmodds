local function handleIncomingCommand(data)
    if data.cmd == "freeze" then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = true end
        showAdminPopup("Voce foi CONGELADO por um admin.")
    elseif data.cmd == "unfreeze" then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
        showAdminPopup("Voce foi DESCONGELADO.")
    elseif data.cmd == "kick" then
        task.delay(0.5, function()
            LocalPlayer:Kick("Admin: " .. (data.args.reason or "Sem motivo"))
        end)
    elseif data.cmd == "message" then
        showAdminPopup(data.args.text or "Mensagem do admin")
    elseif data.cmd == "burn" then
        local char = LocalPlayer.Character
        if char then
            local fire = Instance.new("Fire")
            fire.Size = 10; fire.Heat = 20
            fire.Parent = char:FindFirstChild("HumanoidRootPart") or char
        end
        showAdminPopup("Voce foi incendiado por um admin.")
    end
end

