local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Settings.Silent and method == "FireServer" and self:IsA("RemoteEvent") then
        local target = GetSilentTarget()
        if target and target.Character then
            local part = target.Character:FindFirstChild(Settings.SilentHitPart)
            if part then
                if math.random(1, 100) > Settings.SilentChance then return oldNamecall(self, ...) end
                local aimPos = part.Position
                local args = {...}
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then args[i] = aimPos; changed = true
                    elseif typeof(v) == "CFrame" then args[i] = CFrame.lookAt(v.Position, aimPos); changed = true end
                end
                if changed then return oldNamecall(self, table.unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

local ESPDrawings = {}
local function CreateESP(player)
    if ESPDrawings[player] then return end
    local d = { Box = Drawing.new("Square"), Line = Drawing.new("Line"), Name = Drawing.new("Text"), Health = Drawing.new("Text") }
    d.Box.Thickness = 1.5; d.Box.Filled = false
    d.Line.Thickness = 1
    d.Name.Size = 13; d.Name.Center = true; d.Name.Outline = true
    d.Health.Size = 11; d.Health.Center = true; d.Health.Outline = true
    ESPDrawings[player] = d
end

local function RemoveESP(player)
    if ESPDrawings[player] then
        for _, v in pairs(ESPDrawings[player]) do v:Remove() end
        ESPDrawings[player] = nil
    end
end

