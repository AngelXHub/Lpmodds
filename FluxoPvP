local Content = Instance.new("Frame"); Content.Size = UDim2.new(1, -190, 1, -50); Content.Position = UDim2.fromOffset(190, 50); Content.BackgroundTransparency = 1; Content.Parent = Main

local Pages = {}
local TabButtons = {}
local CurrentTab = nil

local function SelectTab(name)
    if CurrentTab == name then return end
    CurrentTab = name
    for tabName, btn in pairs(TabButtons) do
        local active = tabName == name
        Services.TweenService:Create(btn.Frame, TweenInfo.new(0.15), { BackgroundColor3 = active and C.CARD_HOVER or C.SIDEBAR }):Play()
        Services.TweenService:Create(btn.Indicator, TweenInfo.new(0.15), { BackgroundTransparency = active and 0 or 1 }):Play()
        Services.TweenService:Create(btn.Icon, TweenInfo.new(0.15), { TextColor3 = active and C.ACCENT or C.TEXT3 }):Play()
        Services.TweenService:Create(btn.Label, TweenInfo.new(0.15), { TextColor3 = active and C.TEXT or C.TEXT2 }):Play()
    end
    for pageName, page in pairs(Pages) do page.Visible = pageName == name end
end

local function CreateTab(name, icon)
    local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1, 0, 0, 36); btn.BackgroundColor3 = C.SIDEBAR; btn.BorderSizePixel = 0; btn.Text = ""; btn.AutoButtonColor = false; btn.Parent = TabList
    local BC = Instance.new("UICorner"); BC.CornerRadius = UDim.new(0, 6); BC.Parent = btn
    local indicator = Instance.new("Frame"); indicator.Size = UDim2.new(0, 3, 0, 18); indicator.Position = UDim2.new(0, 0, 0.5, -9); indicator.BackgroundColor3 = C.ACCENT; indicator.BorderSizePixel = 0; indicator.BackgroundTransparency = 1; indicator.Parent = btn
    local IC = Instance.new("UICorner"); IC.CornerRadius = UDim.new(1, 0); IC.Parent = indicator
    local iconLbl = Instance.new("TextLabel"); iconLbl.Size = UDim2.fromOffset(20, 20); iconLbl.Position = UDim2.fromOffset(15, 8); iconLbl.BackgroundTransparency = 1; iconLbl.Text = icon or "▸"; iconLbl.TextColor3 = C.TEXT3; iconLbl.Font = Enum.Font.GothamBold; iconLbl.TextSize = 13; iconLbl.Parent = btn
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, -45, 1, 0); lbl.Position = UDim2.fromOffset(42, 0); lbl.BackgroundTransparency = 1; lbl.Text = name; lbl.TextColor3 = C.TEXT2; lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 11; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn

    btn.MouseEnter:Connect(function()
        if CurrentTab ~= name then Services.TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.CARD }):Play(); Services.TweenService:Create(lbl, TweenInfo.new(0.15), { TextColor3 = C.TEXT }):Play() end
    end)
    btn.MouseLeave:Connect(function()
        if CurrentTab ~= name then Services.TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.SIDEBAR }):Play(); Services.TweenService:Create(lbl, TweenInfo.new(0.15), { TextColor3 = C.TEXT2 }):Play() end
    end)
    btn.MouseButton1Click:Connect(function() SelectTab(name) end)

    local page = Instance.new("Frame"); page.Size = UDim2.fromScale(1, 1); page.BackgroundTransparency = 1; page.Visible = false; page.Parent = Content
    local pageHeader = Instance.new("Frame"); pageHeader.Size = UDim2.new(1, -40, 0, 60); pageHeader.Position = UDim2.fromOffset(20, 10); pageHeader.BackgroundTransparency = 1; pageHeader.Parent = page
    local pageTitle = Instance.new("TextLabel"); pageTitle.Size = UDim2.new(1, 0, 0, 26); pageTitle.Position = UDim2.fromOffset(0, 5); pageTitle.BackgroundTransparency = 1; pageTitle.Text = name; pageTitle.TextColor3 = C.TEXT; pageTitle.Font = Enum.Font.GothamBold; pageTitle.TextSize = 18; pageTitle.TextXAlignment = Enum.TextXAlignment.Left; pageTitle.Parent = pageHeader
    local pageSub = Instance.new("TextLabel"); pageSub.Size = UDim2.new(1, 0, 0, 14); pageSub.Position = UDim2.fromOffset(0, 30); pageSub.BackgroundTransparency = 1; pageSub.Text = "Configure " .. name .. " settings"; pageSub.TextColor3 = C.TEXT3; pageSub.Font = Enum.Font.Gotham; pageSub.TextSize = 10; pageSub.TextXAlignment = Enum.TextXAlignment.Left; pageSub.Parent = pageHeader
    local pageLine = Instance.new("Frame"); pageLine.Size = UDim2.new(1, -40, 0, 1); pageLine.Position = UDim2.fromOffset(20, 72); pageLine.BackgroundColor3 = C.BORDER; pageLine.BorderSizePixel = 0; pageLine.Parent = page
    local scroll = Instance.new("ScrollingFrame"); scroll.Size = UDim2.new(1, -30, 1, -95); scroll.Position = UDim2.fromOffset(15, 80); scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 3; scroll.ScrollBarImageColor3 = C.ACCENT; scroll.ScrollBarImageTransparency = 0.5; scroll.CanvasSize = UDim2.new(0, 0, 0, 0); scroll.Parent = page
    local scrollLayout = Instance.new("UIListLayout"); scrollLayout.Padding = UDim.new(0, 5); scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder; scrollLayout.Parent = scroll
    scrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() scroll.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y + 15) end)

