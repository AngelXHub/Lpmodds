    espEntries[player] = {
        box = box, boxStroke = boxStroke,
        name = nameLabel, dist = distLabel,
        healthBg = healthBg, health = healthFill,
        tracer = tracer, highlight = nil,
    }
end

local function destroyESPEntry(player)
    local e = espEntries[player]
    if not e then return end
    for _, v in pairs(e) do
        if typeof(v) == "Instance" then pcall(function() v:Destroy() end) end
    end
    espEntries[player] = nil
end

local function getHighlight(player)
    local e = espEntries[player]
    if not e then return nil end
    if e.highlight and e.highlight.Parent then return e.highlight end
    local char = player.Character
    if not char then return nil end
    local h = Instance.new("Highlight")
    h.Name = "LpChams"
    h.FillColor = ACCENT
    h.OutlineColor = ACCENT
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Adornee = char
    h.Parent = char
    e.highlight = h
    return h
end

local function clearHighlight(player)
    local e = espEntries[player]
    if e and e.highlight then
        pcall(function() e.highlight:Destroy() end)
        e.highlight = nil
    end
end

local function drawESPFor(player)
    local e = espEntries[player]
    if not e then return end

    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")

    local function hideAll()
        e.box.Visible = false
        e.name.Visible = false
        e.dist.Visible = false
        e.healthBg.Visible = false
        e.tracer.Visible = false
        clearHighlight(player)
    end

    if not (char and head and hrp and hum and hum.Health > 0) then hideAll(); return end
    if not Settings.ESP_Master then hideAll(); return end

    local camPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then hideAll(); return end

    local topPos    = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    if not (topPos and bottomPos) then hideAll(); return end

    local height = math.abs(bottomPos.Y - topPos.Y)
    local width  = height * 0.6
    local topX = topPos.X
    local topY = topPos.Y

    if Settings.ESP_Boxes then
        e.box.Size = UDim2.fromOffset(width, height)
        e.box.Position = UDim2.fromOffset(topX - width / 2, topY)
        e.boxStroke.Color = ACCENT
        e.box.Visible = true
    else
        e.box.Visible = false
    end

    if Settings.ESP_Names then
        e.name.Text = player.Name
        e.name.Size = UDim2.fromOffset(width + 60, 16)
        e.name.Position = UDim2.fromOffset(topX - (width + 60) / 2, topY - 20)
        e.name.Visible = true
    else
        e.name.Visible = false
    end

    if Settings.ESP_Distance then
        local myChar = LP.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local d = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
        e.dist.Text = tostring(d) .. "m"
        e.dist.Size = UDim2.fromOffset(width + 60, 14)
        e.dist.Position = UDim2.fromOffset(topX - (width + 60) / 2, topY + height + 2)
        e.dist.Visible = true
    else
        e.dist.Visible = false
    end

    if Settings.ESP_Health then
        e.healthBg.Size = UDim2.fromOffset(4, height)
        e.healthBg.Position = UDim2.fromOffset(topX - width / 2 - 8, topY)
        e.healthBg.Visible = true
        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        e.health.Size = UDim2.new(1, 0, pct, 0)
        e.health.BackgroundColor3 = Color3.fromRGB(255 - 175 * pct, 80 + 140 * pct, 120)
    else
        e.healthBg.Visible = false
    end

    if Settings.ESP_Lines then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        local target = Vector2.new(camPos.X, topPos.Y)
        local dx = target.X - center.X
        local dy = target.Y - center.Y
        local len = math.sqrt(dx * dx + dy * dy)
        local ang = math.atan2(dy, dx)
        e.tracer.Size = UDim2.fromOffset(len, 1)
        e.tracer.Position = UDim2.fromOffset(center.X, center.Y)
        e.tracer.Rotation = math.deg(ang)
        e.tracer.BackgroundColor3 = ACCENT
        e.tracer.Visible = true
    else
        e.tracer.Visible = false
    end

    if Settings.ESP_Player then
        local h = getHighlight(player)
        if h then h.Adornee = char end
    else
        clearHighlight(player)
    end
end

