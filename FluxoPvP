-- ============ HIDE EXECUTOR + SCRIPT (Delta / Arceus compatible) ============
local HideSelf = {}

local function safeCall(fn, ...)
    local ok, res = pcall(fn, ...)
    if ok then return res end
    return nil
end

function HideSelf.SpoofIdentity()
    if type(getscriptclosure) == "function" then
        local ok = pcall(function()
            local old = getscriptclosure(script)
            if old then
                if type(setscriptclosure) == "function" then
                    setscriptclosure(script, function() return nil end)
                end
            end
        end)
    end

    if type(setreadonly) == "function" and type(getrawmetatable) == "function" then
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        safeCall(setreadonly, mt, false)
        mt.__index = newcclosure(function(self, key)
            if self == script and (key == "Name" or key == "ClassName") then
                return key == "Name" and "CoreClient" or "LocalScript"
            end
            return oldIndex(self, key)
        end)
        safeCall(setreadonly, mt, true)
    end
end

function HideSelf.KillExecutorWindow()
    if type(gethui) == "function" then
        local hui = gethui()
        if hui and hui.Parent ~= game.CoreGui then
            safeCall(function() hui.Parent = game.CoreGui end)
        end
    end

    -- Nuke anything that looks like an executor console / debug window
    local suspiciousNames = {
        "Delta", "DeltaGui", "DeltaUI",
        "Arceus", "ArceusGui", "ArceusUI",
        "Executor", "Console", "ScriptEditor", "ScriptHub", "Debug"
    }

    safeCall(function()
        for _, gui in pairs(game.CoreGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, name in pairs(suspiciousNames) do
                    if gui.Name:lower():find(name:lower()) and gui.Name ~= "LpModsFloatingButtonGui"
                        and gui.Name ~= "LpModsTopBanner" then
                        safeCall(function() gui.Enabled = false end)
                        safeCall(function() gui.Parent = nil end)
                    end
                end
            end
        end
    end)

    safeCall(function()
        for _, gui in pairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, name in pairs(suspiciousNames) do
                    if gui.Name:lower():find(name:lower()) then
                        safeCall(function() gui.Enabled = false end)
                    end
                end
            end
        end
    end)
end

function HideSelf.ScrubScript()
    -- Detach from every weak registry we can touch
    if type(getgc) == "function" then
        safeCall(function()
            for _, obj in pairs(getgc(true)) do
                if type(obj) == "table" and rawget(obj, "__namecall") then
                    if rawget(obj, "__namecall") ~= nil then
                        -- leave our own hook alone
                    end
                end
            end
        end)
    end

    if type(getreg) == "function" then
        safeCall(function()
            local reg = getreg()
            if type(reg) == "table" then
                for k, v in pairs(reg) do
                    if type(v) == "userdata" and tostring(v):find("LpMods") then
                        reg[k] = nil
                    end
                end
            end
        end)
    end

    if type(clear_script_cache) == "function" then safeCall(clear_script_cache) end
    if type(clear_http_cache) == "function" then safeCall(clear_http_cache) end

    if type(hookfunction) == "function" then
        safeCall(hookfunction, error, function() return nil end)
    end
end

function HideSelf.ApplyAll()
    HideSelf.SpoofIdentity()
    HideSelf.KillExecutorWindow()
    HideSelf.ScrubScript()
    pcall(function()
        if Window and Window.Notify then
            Window:Notify({ Title = "LpMods", Content = "stealth applied.", Duration = 3 })
        end
    end)
end
